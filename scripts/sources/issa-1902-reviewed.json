  "poems": [
    {"scan": 4, "page": 2, "text": "心から大く見ゆる初日かな", "comparison": "hatsu-hi", "comparisonSha256": "07d3fbdc8eff5e1a47d368345129836f4af0c834ab8999d98883b0114e43def7", "note": "The 1902 printing has 大く; Lanoue's comparison has 大きく."},
    {"scan": 4, "page": 3, "text": "土蔵から筋違にさす初日かな", "comparison": "hatsu-hi", "comparisonSha256": "718eb37e037ba4ce51b27c22b93b1d22fc547d4ef3a5069e5b9d33c3c909f9e7"},
    {"scan": 4, "page": 3, "text": "初空へさし出す獅子の頭かな", "comparison": "hatsuzora", "comparisonSha256": "c5bbfb42039288907475654bafa9cc77629e07208c028252a492639f940323e4", "note": "The 1902 printing has 頭; Lanoue's comparison has 首."},
    {"scan": 4, "page": 3, "text": "初春や千代のためしに立ち給ふ", "comparison": "hatsu-haru", "comparisonSha256": "3ddb7e33efcb7e7bab6fe207839e8c6ed2431e28e72d46cfb4e8303b4bada30e"},
    {"scan": 4, "page": 3, "text": "初夢に猫も不二見る寝やうかな", "comparison": "hatsu-yume", "comparisonSha256": "c318363ad7629e17892e8bb59a0969a6da88017ea1d662b1f9551c7c9e114685"},
    {"scan": 10, "page": 14, "text": "陽炎や縁からころりねぼけ猫", "comparison": "kagero-2", "comparisonSha256": "33a3e52964571037bbbcfe69c8549b7d666bc83e13f51661f69bb988c94b8895"},
    {"scan": 10, "page": 14, "text": "陽炎や鍬で追やる村鴉", "comparison": "kagero-1", "comparisonSha256": "f1abd7a84da6b8fa679968a0a63d2736f1ed7a2349ef9fc82a0446060bbf4ebb", "note": "The 1902 printing has 鴉; Lanoue's comparison has 烏."},
    {"scan": 10, "page": 14, "text": "陽炎や土の姉様土僧都", "comparison": "kagero-2", "comparisonSha256": "f4e8caef03a4b5935f99acddd695cadac9cf4c1ab2101f8a21acd89bd4fdb065"},
    {"scan": 10, "page": 14, "text": "陽炎や寺へ行かれし杖の穴", "comparison": "kagero-2", "comparisonSha256": "76c6750acf4d4fb3b6fdef5abe64609a066354e424ed64b0f1c9e859319b4b96", "note": "The 1902 printing has 寺へ; Lanoue's comparison has 寺に."},
    {"scan": 10, "page": 14, "text": "陽炎や掃捨芥の銭になる", "comparison": "kagero-2", "comparisonSha256": "1dea9a2da738235f27d88407c07c952e0c95327afbd07c6587cef587e17e7e1a", "note": "The 1902 printing has 芥の; Lanoue's comparison has 塵も."},
    {"scan": 10, "page": 14, "text": "陽炎や歩行ながらの御法談", "comparison": "kagero-2", "comparisonSha256": "c1d62a0a1e85c07a653bbe5de759a6626282d5dba218074c3fab55eb34468673"},
    {"scan": 10, "page": 15, "text": "陽炎や子をかくされし親の顔", "comparison": "kagero-1", "comparisonSha256": "b2389583c8cdb8cab9c09833822e73a8b1f2b326d1cb1fd05b6b36d2cb7ff19d"},
    {"scan": 10, "page": 15, "text": "陽炎や手に下駄穿いて善光寺", "comparison": "kagero-2", "comparisonSha256": "a4f8058a2ca7d93babbf366f39e7a22f42897c164cc89771e9a1b0684554af05"},
    {"scan": 10, "page": 15, "text": "陽炎や蕎麦屋の前の箸の山", "comparison": "kagero-2", "comparisonSha256": "038f5e3d0055f55a9a44378b459d5a08883954731b7ebb0c37a302fcd0c416ff", "note": "The 1902 printing has 蕎麦屋の前; Lanoue's comparison has そば屋が前."},
    {"scan": 10, "page": 15, "text": "陽炎の中からもたつ浅生かな", "comparison": "kagero-2", "comparisonSha256": "f6cac08bc119f0fdeeb0d19fd1f6a4e1f47f39471339b610a9fc151d02842fd6"},
    {"scan": 20, "page": 35, "text": "古雛やがらくた店の日なたぼこ", "comparison": "hina-4", "comparisonSha256": "839ef7b9c133af10a95d19cc453374e22ed56e5e8dff8bd238d24d7a5ee28708"},
    {"scan": 20, "page": 35, "text": "居並んで達磨も雛の仲間かな", "comparison": "hina-4", "comparisonSha256": "5d728e745a3e6faea705ec1587eafdeaec7dc3477a602b714add7e5c7bd45212"},
    {"scan": 20, "page": 35, "text": "雛棚に糞をして行く雀かな", "comparison": "hina-4", "comparisonSha256": "8e2542cdc8f9c8771a1f0a214fd428a8651fce4d2c39d5dd50add6b423386791"},
    {"scan": 20, "page": 35, "text": "手のひらに飾つて見るや市の雛", "comparison": "hina-4", "comparisonSha256": "f46ff1cdf20ae48947767c32a972587d479ee77107784ba5d8dbfa8e434009dd", "note": "The 1902 printing ends 市の雛; Lanoue's comparison ends 雛の市."},
    {"scan": 20, "page": 35, "text": "煤雛しかも上座を召されけり", "comparison": "hina-3", "comparisonSha256": "d2f9cbf9c16ea850e17ae8cee993bc58c9b88f862d800d1b81c31017e9d89875", "note": "The 1902 printing begins 煤雛; Lanoue's comparison begins 煤け雛."},
    {"scan": 30, "page": 54, "text": "花桶に蝶もきくかよ一大事", "comparison": "cho-1", "comparisonSha256": "1d41f5a236ef07fda73b4c99575c4cda438bfe8b6b0e5c9aa379c1da247d0c02"},
    {"scan": 30, "page": 55, "text": "枕する腕に蝶々の寝たりけり", "comparison": "hina-3", "comparisonSha256": "ac30ec276d121daec08036815256d927d15793c0594aafd5dc666d996c68a0e5", "note": "The 1902 printing has 蝶々; Lanoue's comparison has 蝶."},
    {"scan": 30, "page": 55, "text": "来る蝶に鼻をあかする垣根かな", "comparison": "cho-6", "comparisonSha256": "a284e347d4766850dd3ea94c75d122e251af93ca0f266060a40ebc7347ef9d81"},
    {"scan": 30, "page": 55, "text": "神風や蛇がをしへる山の道", "comparison": "hebi", "comparisonSha256": "e3f9afd06f3982dd6d315cbe157f0a92ea0bdbe4dee3dd7de1a6d5eac8bb0b2a"},
    {"scan": 50, "page": 94, "text": "蟻の道雲の峰よりつゞきけり", "comparison": "kumo-1", "comparisonSha256": "831a5eee8ede11b11ba4464cd16f1d5cca269dcf6a0c80c4751e1c25aeeedec6"},
    {"scan": 50, "page": 94, "text": "湖水から出現したり雲の峰", "comparison": "kumo-2", "comparisonSha256": "8e65b78f91da038757c6e32916e03795cd20fc87bcfc901667e65737da437019"},
    {"scan": 50, "page": 94, "text": "なげ出した足のさきなり雲の峰", "comparison": "kumo-1", "comparisonSha256": "1252c893650092848c4e9b2351419263897ece4b41c2c172a54fb77afc4e446c"},
    {"scan": 50, "page": 94, "text": "湖へずり出したり雲の峰", "comparison": "kumo-1", "comparisonSha256": "d450a1decd8e6f55a2990f5f19c940600d62fea2d646998d291e3b7d335d4f67", "note": "The 1902 printing has 出したり; Lanoue's comparison has 出しけり."},
    {"scan": 50, "page": 94, "text": "山人の枕の際や雲のみね", "comparison": "kumo-1", "comparisonSha256": "0ce7b2fc54cc1c62113021278f4a70954fb583086072769f18d3d3c62bb0aa91"},
    {"scan": 50, "page": 95, "text": "寝むしろや足でかぞへる雲の峰", "comparison": "kumo-1", "comparisonSha256": "fcf5df1d8b99277d5423a094c7cd68803baf911fab70ba1ec2902747eaa5415d"},
    {"scan": 50, "page": 95, "text": "風あるを以て尊し雲の峰", "comparison": "kumo-1", "comparisonSha256": "ae0960e20b192767d509117d42b7fc52b653313c5037fc6e0933bc83c77fe475"},
    {"scan": 50, "page": 95, "text": "あの中に鬼やこもらん雲の峰", "comparison": "kumo-2", "comparisonSha256": "35c25f8e7dafa906a3d84dbd7fc3aea53b36ce4e519980c349c17bf17d3f4e91"},
    {"scan": 115, "page": 224, "text": "鼠等もままごとするか杓子栗", "comparison": "kuri-2", "comparisonSha256": "1cf8bbefd0fb6026a8612caeb9b676d4505a700cf8289c406a0c631af4818c9b", "note": "The 1902 printing's vertical まゝ is expanded to まま; Lanoue's comparison instead reads 嫁事."},
    {"scan": 115, "page": 224, "text": "流るるに苦はなかりけり実なし栗", "comparison": "kuri-1", "comparisonSha256": "2ef0555621ffd77e8ee8064604802aac7fb120e0ea862180f04812878411b141", "note": "The printed repetition mark after る is expanded for horizontal reading."},
    {"scan": 115, "page": 224, "text": "大きさや人の拾ひし栗の毬", "comparison": "kuri-2", "comparisonSha256": "b80509d63526d941ace6e504f038672537028c9f003195ebd59c1fe10e949890"},
    {"scan": 130, "page": 255, "text": "初雪をいまいましいといふべかな", "comparison": "hatsu-yuki-1", "comparisonSha256": "d4f57475823d523a0bc621115dfee2d2b6087e33814e482cd2d9c5a34f8bf7e7", "note": "The 1902 printing's vertical いま〳〵 is expanded to いまいま; Lanoue's comparison has 夕 where the printing reads いふべ."},
