      "comparisonStart": "id00007",
      "comparisonEnd": "id00044",
      "note": "The 1920 print repeats “devant devant”, omitted in both digital transcriptions; this is restored from the scan. Several breaks introduced around long-line markup are removed. The print also has “en élevant”, “flamands”, “fonds” and “la regarder” where the comparison differs.",
      "edits": [
        {
          "page": 8,
          "before": "Située à Paris entre la rue Aumont-Thiéville et l’avenue des Ternes\n\nVoilà la jeune rue et tu n’es encore qu’un petit enfant",
          "after": "Située à Paris entre la rue Aumont-Thiéville et l’avenue des Ternes\nVoilà la jeune rue et tu n’es encore qu’un petit enfant"
        },
        {
          "page": 8,
          "before": "Vous n’aimez rien tant que les pompes de l’Église\n\nIl est neuf heures le gaz est baissé tout bleu vous sortez du dortoir en cachette",
          "after": "Vous n’aimez rien tant que les pompes de l’Église\nIl est neuf heures le gaz est baissé tout bleu vous sortez du dortoir en cachette"
        },
        {
          "page": 11,
          "before": "L’amour dont je souffre est une maladie honteuse\n\nEt l’image qui te possède te fait survivre dans l’insomnie et dans l’angoisse",
          "after": "L’amour dont je souffre est une maladie honteuse\nEt l’image qui te possède te fait survivre dans l’insomnie et dans l’angoisse"
        },
        {
          "page": 13,
          "before": "J’ai vécu comme un fou et j’ai perdu mon temps\n\nTu n’oses plus regarder tes mains et à tous moments je voudrais sangloter",
          "after": "J’ai vécu comme un fou et j’ai perdu mon temps\nTu n’oses plus regarder tes mains et à tous moments je voudrais sangloter"
        },
        {
          "page": 14,
          "before": "Et revenir dans leur pays après avoir fait fortune\n\nUne famille transporte un édredon rouge comme vous transportez votre cœur",
          "after": "Et revenir dans leur pays après avoir fait fortune\nUne famille transporte un édredon rouge comme vous transportez votre cœur"
        },
        {
          "page": 15,
          "before": "Dormir parmi tes fétiches d’Océanie et de Guinée\n\nIls sont des Christ d’une autre forme et d’une autre croyance",
          "after": "Dormir parmi tes fétiches d’Océanie et de Guinée\nIls sont des Christ d’une autre forme et d’une autre croyance"
        },
        {
          "page": 14,
          "before": "Tu es debout devant le zinc d’un bar crapuleux",
          "after": "Tu es debout devant devant le zinc d’un bar crapuleux"
        }
